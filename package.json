{
  "name": "last60",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:mongo": "bun scripts/dev-mongo.ts",
    "dev:indexer": "bun --watch apps/worker/src/indexer.ts",
    "dev:rewards": "bun --watch apps/worker/src/rewards.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "start:indexer": "bun apps/worker/src/indexer.ts",
    "start:rewards": "bun apps/worker/src/rewards.ts",
    "start:api": "bun apps/api/src/index.ts",
    "start:web": "bun run --cwd apps/web start",
    "cli": "bun apps/worker/src/cli.ts",
    "test": "bun test packages apps/api apps/worker",
    "typecheck": "tsc -p packages/engine && tsc -p packages/shared && tsc -p apps/api && tsc -p apps/worker && bun run --cwd apps/web typecheck",
    "brand:render": "bun scripts/render-brand.ts",
    "fixtures:fetch": "bun scripts/fetch-fixtures.ts",
    "verify:fees": "bun scripts/verify-fee-attribution.ts",
    "verify:allocation": "bun scripts/verify-allocation.ts",
    "verify:platform-config": "bun scripts/verify-launchlab-platform-config.ts",
    "verify:round": "bun scripts/verify-round.ts",
    "report:revenue": "bun scripts/revenue-report.ts",
    "fixtures:cpmm-fee-share": "bun scripts/fetch-cpmm-fee-share-fixtures.ts",
    "find:pool": "bun scripts/find-active-pool.ts",
    "screenshot": "bun scripts/screenshot.ts"
  },
  "devDependencies": {
    "@fontsource/michroma": "5.3.0",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "opentype.js": "2.0.0",
    "typescript": "5.9.3"
  }
}
