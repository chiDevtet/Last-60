# ════════════════════════════════════════════════════════════════════════════════
#  LAST60 — environment configuration
#  Every variable is validated at process start; errors list every problem at once.
#  Secrets NEVER use the NEXT_PUBLIC_ prefix (startup refuses it).
#  Process roles: indexer, rewards (the only process that holds keys), api, web.
# ════════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info                     # trace|debug|info|warn|error

# ── Solana ──────────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=mainnet-beta        # mainnet-beta | devnet | testnet | localnet
SOLANA_RPC_URL=                    # e.g. https://mainnet.helius-rpc.com/?api-key=… (or set HELIUS_API_KEY)
SOLANA_RPC_FALLBACK_URLS=          # optional, comma separated; used on failover
SOLANA_WS_URL=                     # optional; derived from SOLANA_RPC_URL if empty
SOLANA_MAX_TX_VERSION=1            # mainnet carries v1 transactions; auto-upgrades on -32015
SOLANA_RPC_TIMEOUT_MS=15000
SOLANA_RPC_MAX_RPS=20              # client-side rate limit per process
HELIUS_API_KEY=                    # optional convenience: builds the Helius RPC URL

# ── Launch provider ─────────────────────────────────────────────────────────────
LAUNCH_PROVIDER=meteora_dbc        # meteora_dbc | raydium_launchlab   (mock: local testing only)
TOKEN_MINT=
POOL_ADDRESS=
FEE_BENEFICIARY_ROLE=creator       # whose fee share is distributed:
                                   #   meteora_dbc: creator | partner   raydium_launchlab: creator | platform
                                   # never change it on a pool that already has indexed activity (refused)

# Declared creator allocation (integers). Used ONLY to verify what the chain says: the accounting
# always uses the on-chain value. Outcomes per allocation:
#   verified      declared = on-chain                → fees are distributable
#   mismatch      declared ≠ on-chain                → fees recorded, NEVER paid (pool flagged)
#   not_declared  left empty                         → fees recorded and reported, NEVER paid
# Check with:  bun run verify:allocation   (read-only; add --forgepad to test Forgepad's targets)
# Three DIFFERENT quantities — do not confuse them with each other or with REWARD_PERCENTAGE:
#   • creator allocation PERCENTAGE  (DBC): % of the trading fee (after the protocol cut) that goes to the creator
#   • creator fee RATE on trade value (LaunchLab): millionths of each TRADE, not of the fees (5000 = 0.5% of the trade)
#   • creator migrated LP share: % (DBC) / millionths (LaunchLab) of the LP created at graduation
# Forgepad's intended targets (to be confirmed on-chain, never assumed): DBC 75 / 75; LaunchLab 5000 / 500000.
# LaunchLab note: since the 2026-08-17 Raydium upgrade, migrations assign creator_scale to the PLATFORM's
# Fee Key; a creator LP Fee Key exists only if the migration transaction actually minted one.
EXPECTED_DBC_CREATOR_TRADING_FEE_PERCENTAGE=   # DBC creator_trading_fee_percentage (0-100), bonding phase
EXPECTED_DBC_CREATOR_LP_PERCENTAGE=            # DBC creator liquid + locked + vesting LP percentage (0-100)
EXPECTED_LAUNCHLAB_CREATOR_FEE_RATE=           # LaunchLab creator_fee_rate, millionths of TRADE VALUE (5000 = 0.5%, the program max)
EXPECTED_LAUNCHLAB_CREATOR_LP_SCALE=           # LaunchLab creator_scale, millionths of migrated LP (500000 = 50%)
# Roles other than "creator" have no declarable allocation: their fees are recorded but never distributed.

# ── Rewards ─────────────────────────────────────────────────────────────────────
BUYER_COUNT=5
MIN_BUY_SOL=0.05
# MIN_BUY_QUOTE_AMOUNT=           # alternative: minimum in quote base units (non-SOL quote pools)
REWARD_PERCENTAGE=75               # LAST60's split of the round's DISTRIBUTABLE creator fees: 75 → 75% to buyer rewards,
                                   # 25% retained. NOT the creator's allocation (that is set on-chain, see EXPECTED_* above).
SKIPPED_ROUND_POLICY=rollover      # rollover | retain — what happens to the reward when nobody qualifies
MIN_PAYOUT_LAMPORTS=1000000        # per-wallet minimum (≥ 890880 rent-exempt); below it the pool rolls over
EXCLUDED_WALLETS=                  # comma separated; pool creator, fee beneficiary and payout wallet are always excluded

# ── Schedule ────────────────────────────────────────────────────────────────────
ROUND_DURATION_SECONDS=300
RANDOM_WINDOW_START_SECONDS=240
RANDOM_WINDOW_DURATION_SECONDS=60
ROUND_ANCHOR_EPOCH_SECONDS=0       # rounds align to :00, :05, … of UTC wall clock
ROUND_GENESIS_AT=                  # optional ISO time of round #1 (default: first rewards-worker start)
LATE_EXECUTION_GRACE_SECONDS=5
SNAPSHOT_SETTLE_MS=1500            # wait after the snapshot slot so the RPC has indexed it
SCHEDULE_ENCRYPTION_KEY=           # REQUIRED (rewards only): openssl rand -base64 32

# ── Payouts ─────────────────────────────────────────────────────────────────────
PAYOUT_ASSET=SOL                   # SOL, or the pool's quote mint (never converted)
PAYOUT_MODE=dry_run                # dry_run (default, nothing is sent) | live
ALLOW_MAINNET_PAYOUTS=false        # second explicit switch required for live payouts on mainnet-beta
PAYOUT_WALLET_PUBLIC_KEY=
PAYOUT_WALLET_KEYPAIR_PATH=        # preferred: path to a chmod 600 Solana keypair file (rewards only)
PAYOUT_WALLET_PRIVATE_KEY=         # alternative: base58 or JSON array (rewards only)
PAYOUT_COMMITMENT=finalized        # confirmed | finalized — a payout is "paid" only at this level
PAYOUT_PRIORITY_FEE_MICROLAMPORTS=10000
PAYOUT_COMPUTE_UNIT_LIMIT=40000
PAYOUT_MAX_ATTEMPTS=5
PAYOUT_WALLET_MIN_RESERVE_LAMPORTS=10000000
PAYOUT_CONCURRENCY=3
PAYOUT_MEMO=true                   # on-chain memo last60:r<round>:<payoutId> for auditability

# ── Fee collection ──────────────────────────────────────────────────────────────
FEE_COLLECTION_MODE=manual         # manual | auto_claim (claims beneficiary fees into the payout wallet)
FEE_CLAIM_AUTHORITY_KEYPAIR_PATH=  # beneficiary key if it differs from the payout wallet (rewards only)
FEE_CLAIM_AUTHORITY_PRIVATE_KEY=
FEE_CLAIM_MIN_LAMPORTS=10000000

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=                       # must be a replica set (Atlas, or mongod --replSet rs0)
MONGODB_DB_NAME=last60

# ── Indexer ─────────────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_USE_WEBSOCKET=true
INDEXER_BACKFILL=full              # full (index pool history on first start) | none (start from now)
INDEXER_BACKFILL_MAX_SIGNATURES=100000
INDEXER_FINALITY_CHECK_MS=10000
INDEXER_DROP_AFTER_SECONDS=180
INDEXER_FETCH_CONCURRENCY=4

# ── API ─────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=https://last60.io     # comma separated web origins (required in production; empty = loopback only in development)
PUBLIC_SITE_URL=https://last60.io  # binds admin sign-in (SIWS) messages to this domain; required in production with ADMIN_WALLETS
ADMIN_WALLETS=                     # comma separated admin public keys
ADMIN_SESSION_SECRET=              # ≥ 32 chars: openssl rand -base64 48
ADMIN_SESSION_TTL_SECONDS=3600
STREAM_SNAPSHOT_INTERVAL_MS=2000
API_TRUST_PROXY_HOPS=0             # reverse proxies in front of the API (1 behind a single nginx); 0 = ignore X-Forwarded-For

# ── Reconciliation & retention ──────────────────────────────────────────────────
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_HALT_ON_OVER_ATTRIBUTION=true
RECONCILIATION_TOLERANCE_LAMPORTS=0
TERMINAL_RETENTION_DAYS=30

# ── Optional worker health endpoints (bound to 127.0.0.1) ───────────────────────
# WORKER_HEALTH_PORT=4101

# ── Web (public, shipped to browsers — never secrets) ──────────────────────────
NEXT_PUBLIC_APP_NAME=LAST60
NEXT_PUBLIC_SOLANA_EXPLORER=https://solscan.io
NEXT_PUBLIC_API_URL=https://api.last60.io
NEXT_PUBLIC_SITE_URL=https://last60.io
NEXT_PUBLIC_TRADE_URL=             # optional "Buy" link (defaults to Jupiter for TOKEN_MINT)
API_INTERNAL_URL=http://127.0.0.1:4000   # server-side rendering fetch target (not public)
