# ════════════════════════════════════════════════════════════════════════════════
#  Asteroid Protocol — environment configuration
#  Every variable is validated at process start; errors list every problem at once.
#  Secrets NEVER use the NEXT_PUBLIC_ prefix (startup refuses it).
#  Process roles: indexer, rewards (the only process that holds keys), api, web.
# ════════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info                     # trace|debug|info|warn|error

# ── Solana ──────────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=mainnet-beta        # mainnet-beta | devnet | testnet | localnet
SOLANA_RPC_URL=                    # e.g. https://mainnet.helius-rpc.com/?api-key=… (or set HELIUS_API_KEY)
SOLANA_RPC_FALLBACK_URLS=          # optional, comma separated; used on failover
SOLANA_WS_URL=                     # optional; derived from SOLANA_RPC_URL if empty
SOLANA_MAX_TX_VERSION=1            # mainnet carries v1 transactions; auto-upgrades on -32015
SOLANA_RPC_TIMEOUT_MS=15000
SOLANA_RPC_MAX_RPS=20              # client-side rate limit per process
HELIUS_API_KEY=                    # optional convenience: builds the Helius RPC URL

# ── Launch provider ─────────────────────────────────────────────────────────────
LAUNCH_PROVIDER=meteora_dbc        # meteora_dbc | raydium_launchlab   (mock: local testing only)
TOKEN_MINT=                        # may be left empty and set from the admin page; workers wait for the launch
POOL_ADDRESS=                      # leave empty: LaunchLab — derived from TOKEN_MINT (SOL quote); Meteora DBC — found from TOKEN_MINT once launched
FEE_BENEFICIARY_ROLE=creator       # whose fee share is distributed:
                                   #   meteora_dbc: creator | partner   raydium_launchlab: creator | platform
                                   # never change it on a pool that already has indexed activity (refused)

# Declared creator allocation (integers). Used ONLY to verify what the chain says: the accounting
# always uses the on-chain value. Outcomes per allocation:
#   verified      declared = on-chain                → fees are distributable
#   mismatch      declared ≠ on-chain                → fees recorded, NEVER paid (pool flagged)
#   not_declared  left empty                         → fees recorded and reported, NEVER paid
# Check with:  bun run verify:allocation   (read-only; add --forgepad to test Forgepad's targets)
# Three DIFFERENT quantities — do not confuse them with each other or with REWARD_PERCENTAGE:
#   • creator allocation PERCENTAGE  (DBC): % of the trading fee (after the protocol cut) that goes to the creator
#   • creator fee RATE on trade value (LaunchLab): millionths of each TRADE, not of the fees (5000 = 0.5% of the trade)
#   • creator migrated LP share: % (DBC) / millionths (LaunchLab) of the LP created at graduation
# Forgepad's intended DBC allocation: 25% platform / 75% creator pre-bond AND post-migration (DBC only).
# Forgepad's LaunchLab PlatformConfig 5zZFa8KitVsp3qGDvCQeDZgn5YEKxAASA5EQTjVzobcX (decoded on mainnet):
#   creator_fee_rate 5000 (0.5% of each trade), fee_rate 10000 (1%), platform_scale 500000, creator_scale 500000.
#   Check it with:  bun run verify:platform-config   (read-only)
# LaunchLab note: creator_scale is NOT a creator entitlement. Since the 2026-08-17 Raydium upgrade migrations
# add it to the PLATFORM's single Fee Key; a creator LP Fee Key exists only if the migration tx minted one.
EXPECTED_DBC_CREATOR_TRADING_FEE_PERCENTAGE=   # DBC creator_trading_fee_percentage (0-100), bonding phase
EXPECTED_DBC_CREATOR_LP_PERCENTAGE=            # DBC creator liquid + locked + vesting LP percentage (0-100)
EXPECTED_LAUNCHLAB_CREATOR_FEE_RATE=           # LaunchLab creator_fee_rate, millionths of TRADE VALUE (5000 = 0.5%, the program max)
EXPECTED_LAUNCHLAB_PLATFORM_CONFIG=            # LaunchLab PlatformConfig the pool must be bound to (required with the rate to verify)
EXPECTED_LAUNCHLAB_CREATOR_LP_SCALE=           # LaunchLab creator_scale VALUE (config fact only; never makes LP fees payable)
EXPECTED_CPMM_CREATOR_FEE_RATE=                # post-migration CPMM AmmConfig creator_fee_rate, millionths of SWAP value (Forgepad 500 = 0.05%)
# Roles other than "creator" have no declarable allocation: their fees are recorded but never distributed.

# ── Phase-aware reward funding (docs/REWARD_FUNDING.md) ──────────────────────────
# Forge's two-phase model. A fee RATE (0.50% bonding, 0.05% CPMM) is what a trade is charged; the
# ALLOCATION percentages below apply to fees ACTUALLY COLLECTED, and only an OBSERVED, correlated
# transfer into an Asteroid Protocol funding destination ever funds buyer rewards (capped at the policy amount).
#   bonding curve : creator fee collected → 25% creator / 75% Asteroid Protocol contribution
#   post-migration: CPMM creator fee      → 100% creator (never Asteroid Protocol funding)
#                   Forge platform LP fees claimed (platform-owned Fee Key) → 50% the CREATOR'S allocation,
#                   dedicated to Asteroid Protocol buyer rewards / 50% Forge
REWARD_FUNDING_POLICY=forge_phase_aware_v2      # forge_phase_aware_v2 (DEFAULT, approved model) | legacy_creator_fee_v1
                                                # forge_phase_aware_v1 (PR #6) is retired and rejected
REWARD_FUNDING_POLICY_ACTIVATION_SLOT=          # empty / "auto" (default): pinned once to the finalized slot at the FIRST start
                                                # of any process and shared through MongoDB (system_state.funding_policy_activation).
                                                # Rounds snapshotting after it are funded ONLY by verified contributions.
                                                # Set a slot only to override (at/after the switch-over).
LAST60_FUNDING_DESTINATIONS=                    # optional extra Asteroid Protocol funding wallets (comma separated); under forge_phase_aware_v2
                                                # LAST60_PAYOUT_WALLET_ADDRESS is always one, so this can stay empty
FORGE_PLATFORM_LP_BENEFICIARY=                  # expected owner of Forge's platform LP Fee Key (= PlatformConfig platform_nft_wallet).
                                                # Default on mainnet-beta: Forgepad's 8KXqQwtrgtKxNfTWYsN34XNKXVQQR78JZfgbLorNL2n1
                                                # (still verified on chain). Required outside mainnet-beta under forge_phase_aware_v2.
                                                # Also the source of Forge's existing creator payouts: after a verified migration the
                                                # indexer watches this wallet's token account for the launch token (REWARD_FUNDING.md §4a)
BONDING_CREATOR_FEE_LAST60_PERCENTAGE=75        # approved model, FIXED: any other value is rejected
FORGE_PLATFORM_LP_LAST60_PERCENTAGE=50          # approved model, FIXED (creator's allocation of each CLAIMED LP fee)
FUNDING_CORRELATION_MODE=strict                 # strict: claim+transfer in one tx, or memo "last60:v1:<claim sig>"
                                                # exclusive_window: also the single open latest claim (recorded, NEVER payable)

# ── Rewards ─────────────────────────────────────────────────────────────────────
BUYER_COUNT=5                      # most recent unique qualifying buyers paid each round
HOLDER_COUNT=5                     # random holders paid alongside them each paying round (0 = holder draw off)
MIN_HOLDER_TOKENS=100000           # minimum holding to enter the holder draw, in WHOLE tokens (0.01% of a 1,000,000,000 supply)
MIN_BUY_SOL=0.05
# MIN_BUY_QUOTE_AMOUNT=           # alternative: minimum in quote base units (non-SOL quote pools)
REWARD_PERCENTAGE=75               # Asteroid Protocol's split of the round's DISTRIBUTABLE creator fees: 75 → 75% to buyer and holder rewards,
                                   # 25% retained. NOT the creator's allocation (that is set on-chain, see EXPECTED_* above).
                                   # Under forge_phase_aware_v2 it is NOT applied to contributions (they already are the
                                   # reward share) and creator fees after the activation slot are no longer distributed.
SKIPPED_ROUND_POLICY=rollover      # rollover | retain — what happens to the reward when nobody qualifies
MIN_PAYOUT_LAMPORTS=1000000        # per-wallet minimum (≥ 890880 rent-exempt); below it the pool rolls over
EXCLUDED_WALLETS=                  # comma separated; pool creator, fee beneficiary and payout wallet are always excluded

# ── Schedule ────────────────────────────────────────────────────────────────────
ROUND_DURATION_SECONDS=300
RANDOM_WINDOW_START_SECONDS=240
RANDOM_WINDOW_DURATION_SECONDS=60
ROUND_ANCHOR_EPOCH_SECONDS=0       # rounds align to :00, :05, … of UTC wall clock
ROUND_GENESIS_AT=                  # optional ISO time of round #1 (default: first rewards-worker start)
LATE_EXECUTION_GRACE_SECONDS=5
SNAPSHOT_SETTLE_MS=1500            # wait after the snapshot slot so the RPC has indexed it
SCHEDULE_ENCRYPTION_KEY=           # REQUIRED (rewards only): openssl rand -base64 32

# ── Payouts ─────────────────────────────────────────────────────────────────────
PAYOUT_ASSET=SOL                   # SOL, or the pool's quote mint (never converted)
PAYOUT_MODE=dry_run                # dry_run (default, nothing is sent) | live
ALLOW_MAINNET_PAYOUTS=false        # second explicit switch required for live payouts on mainnet-beta
# Dedicated Asteroid Protocol payout wallet (docs/PAYOUT_WALLET.md). Generated and supplied by the operator — never
# commit a key. The address goes in every process; the key ONLY in .env.rewards, and it must derive exactly
# this address (the rewards worker refuses to start otherwise). Legacy names PAYOUT_WALLET_PUBLIC_KEY /
# PAYOUT_WALLET_KEYPAIR_PATH / PAYOUT_WALLET_PRIVATE_KEY are accepted as aliases (never with other values).
LAST60_PAYOUT_WALLET_ADDRESS=
LAST60_PAYOUT_WALLET_KEYPAIR_PATH= # preferred: path to a chmod 600 solana-keygen JSON keypair file (rewards only)
LAST60_PAYOUT_WALLET_PRIVATE_KEY=  # alternative: base58 64-byte secret key or JSON array of 64 bytes (rewards only)
PAYOUT_COMMITMENT=finalized        # confirmed | finalized — a payout is "paid" only at this level
PAYOUT_PRIORITY_FEE_MICROLAMPORTS=10000
PAYOUT_COMPUTE_UNIT_LIMIT=40000
PAYOUT_MAX_ATTEMPTS=5
PAYOUT_WALLET_MIN_RESERVE_LAMPORTS=10000000
PAYOUT_CONCURRENCY=3
PAYOUT_MEMO=true                   # on-chain memo last60:r<round>:<payoutId> for auditability

# ── Custody and attribution recovery (docs/REWARD_FUNDING.md §14–§15) ──────────
# Rounds always require verified custody of contributions in the payout wallet.
LAST60_CUSTODY_ENABLED=                    # default: on under forge_phase_aware_v2 with a payout wallet (sweep requests +
                                           # verification of custody transfers); set false to disable
LAST60_CUSTODY_REQUEST_TTL_HOURS=168       # an open sweep request expires after this
LAST60_ATTRIBUTION_RECOVERY_ENABLED=false  # operator re-run of the normal attribution for unresolved Forge payouts

# ── Launch creator wallet automation (docs/CREATOR_WALLET.md) ──────────────────
# With the creator's key in .env.rewards, the rewards worker — with no manual step — claims the
# bonding-curve creator fees into the creator wallet, sends 75 % of each claim to the payout wallet
# (memo last60:v1:<claim>) and sweeps Forge's post-migration creator payouts into the payout wallet
# (custody memo last60:custody:v1:<id>). The creator wallet only ever sends to LAST60_PAYOUT_WALLET_ADDRESS.
LAST60_CREATOR_WALLET_ADDRESS=             # the launch creator's public address (every process; cross-checked with the key
                                           # and with the pool's on-chain creator)
LAST60_CREATOR_WALLET_KEYPAIR_PATH=        # preferred: chmod 600 solana-keygen JSON keypair file (REWARDS ONLY)
LAST60_CREATOR_WALLET_PRIVATE_KEY=         # alternative: base58 / JSON 64-byte secret key (REWARDS ONLY)
LAST60_CREATOR_AUTOMATION_ENABLED=         # default: on whenever the creator key is configured; false to disable
LAST60_CREATOR_AUTOMATION_INTERVAL_SECONDS=30
LAST60_CREATOR_MIN_TRANSFER_LAMPORTS=10000 # smaller remainders are left (not worth a network fee)
LAST60_CREATOR_FEE_RESERVE_LAMPORTS=2000000 # SOL always left in the creator wallet for network fees

# ── Wallet vault (docs/WALLETS.md) ─────────────────────────────────────────────
# Payout / creator wallets can be generated from the admin page instead of the variables above. Their keys
# are encrypted by the rewards worker with a vault key file created on first use (REWARDS ONLY).
LAST60_WALLET_VAULT_KEY_PATH=      # default ~/.last60/wallet-vault.key (chmod 600, outside the repository)
LAST60_WALLET_VAULT_KEY=           # optional: the 32-byte key itself, base64 (overrides the file)
# Exporting a generated key from the admin page also needs ADMIN_WALLETS in the REWARDS worker's environment.

# ── Fee collection ──────────────────────────────────────────────────────────────
FEE_COLLECTION_MODE=               # manual | auto_claim. Default: auto_claim when LAST60_CREATOR_WALLET_* is set, else manual.
                                   # forge_phase_aware_v2: claims land in the claimer's (creator's) own wallet and the
                                   # 75 % follows to the payout wallet; legacy: claims are unwrapped into the payout wallet.
FEE_CLAIM_AUTHORITY_KEYPAIR_PATH=  # beneficiary key for auto_claim when it is not the creator wallet above (rewards only;
FEE_CLAIM_AUTHORITY_PRIVATE_KEY=   # the payout wallet key never signs claims)
FEE_CLAIM_MIN_LAMPORTS=10000000

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=                       # must be a replica set (Atlas, or mongod --replSet rs0)
MONGODB_DB_NAME=last60

# ── Indexer ─────────────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_USE_WEBSOCKET=true
INDEXER_BACKFILL=full              # full (index pool history on first start) | none (start from now)
INDEXER_BACKFILL_MAX_SIGNATURES=100000
INDEXER_FINALITY_CHECK_MS=10000
INDEXER_DROP_AFTER_SECONDS=180
INDEXER_FETCH_CONCURRENCY=4

# ── API ─────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=https://last60.fun     # comma separated web origins (required in production; empty = loopback only in development)
PUBLIC_SITE_URL=https://last60.fun  # binds admin sign-in (SIWS) messages to this domain; required in production with ADMIN_WALLETS
ADMIN_WALLETS=                     # comma separated admin public keys
ADMIN_SESSION_SECRET=              # ≥ 32 chars: openssl rand -base64 48
ADMIN_SESSION_TTL_SECONDS=3600
STREAM_SNAPSHOT_INTERVAL_MS=2000
API_TRUST_PROXY_HOPS=0             # reverse proxies in front of the API (1 behind a single nginx); 0 = ignore X-Forwarded-For

# ── Reconciliation & retention ──────────────────────────────────────────────────
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_HALT_ON_OVER_ATTRIBUTION=true
RECONCILIATION_TOLERANCE_LAMPORTS=0
TERMINAL_RETENTION_DAYS=30

# ── Optional worker health endpoints (bound to 127.0.0.1) ───────────────────────
# WORKER_HEALTH_PORT=4101

# ── Web (public, shipped to browsers — never secrets) ──────────────────────────
NEXT_PUBLIC_APP_NAME="Asteroid Protocol"
NEXT_PUBLIC_SOLANA_EXPLORER=https://solscan.io
NEXT_PUBLIC_API_URL=https://last60.fun
NEXT_PUBLIC_SITE_URL=https://last60.fun
NEXT_PUBLIC_TRADE_URL=             # optional "Buy" link (defaults to Jupiter for TOKEN_MINT)
API_INTERNAL_URL=http://127.0.0.1:4000   # server-side rendering fetch target (not public)
